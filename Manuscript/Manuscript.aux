\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Nitric oxide synthase is expressed in interneurons of the UV-avoidance circuit}{3}{subsubsection*.4}\protected@file@percent }
\newlabel{nitric-oxide-synthase-is-expressed-in-interneurons-of-the-uv-avoidance-circuit}{{}{3}{Nitric oxide synthase is expressed in interneurons of the UV-avoidance circuit}{subsubsection*.4}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Figure 1. Identification of \emph  {NOS}-expressing interneurons (INNOS) within the cPRC circuit.} (\textbf  {A}) Scanning electron microscopy image of a 3-day-old \emph  {Platynereis} larva. (\textbf  {B, C}) Volume rendering of the neuron types (cPRC, INNOS, INRGWa, Ser-h1 and MC) in the cPRC circuit reconstructed from a whole-body transmission electron microscopy volume of a 3-day-old larva. Neurite skeletons are shown with cell-body positions represented by spheres. Projections of all neurons in the body are shown in grey to highlight the neuropils. The outline of the yolk is also indicated in grey. In B, nuclei positions of the prototroch head ciliary band are shown as grey spheres. (\textbf  {D}) Volume rendering of the four INNOS neurons with incoming and outgoing synapses. (\textbf  {E}) Expression of the \emph  {NOS} gene detected by in situ HCR (magenta) in a 2-day-old larva (anterior view). Antibody staining for acetylated α-tubulin (acTub: green) highlights cPRC cilia and the neuropil. (\textbf  {F}) Expression of a \emph  {NOS} reporter (NOSp::palmi-3xHA; magenta) labelled with an anti-HA antibody in a 2-day-old larva (anterior view). Antibody staining for acetylated α-tubulin (acTub; green) highlights cPRC cilia and the neuropil. (\textbf  {G}) Immunostaining for NOS (magenta), co-stained for acetylated α-tubulin (acTub; green). (\textbf  {H}) Synaptic wiring diagram of the cPRC circuit. Hexagons represent cell groups, with the number of cells per group shown in square brackets. Arrows represent the summed number of synaptic contacts between cell groups. Arrow thickness is proportional to the number of synapses.}}{4}{figure.caption.5}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Figure 1. Identification of \emph  {NOS}-expressing interneurons (INNOS) within the cPRC circuit.} (\textbf  {A}) Scanning electron microscopy image of a 3-day-old \emph  {Platynereis} larva. (\textbf  {B, C}) Volume rendering of the neuron types (cPRC, INNOS, INRGWa, Ser-h1 and MC) in the cPRC circuit reconstructed from a whole-body transmission electron microscopy volume of a 3-day-old larva. Neurite skeletons are shown with cell-body positions represented by spheres. Projections of all neurons in the body are shown in grey to highlight the neuropils. The outline of the yolk is also indicated in grey. In B, nuclei positions of the prototroch head ciliary band are shown as grey spheres. (\textbf  {D}) Volume rendering of the four INNOS neurons with incoming and outgoing synapses. (\textbf  {E}) Expression of the \emph  {NOS} gene detected by in situ HCR (magenta) in a 2-day-old larva (anterior view). Antibody staining for acetylated α-tubulin (acTub: green) highlights cPRC cilia and the neuropil. (\textbf  {F}) Expression of a \emph  {NOS} reporter (NOSp::palmi-3xHA; magenta) labelled with an anti-HA antibody in a 2-day-old larva (anterior view). Antibody staining for acetylated α-tubulin (acTub; green) highlights cPRC cilia and the neuropil. (\textbf  {G}) Immunostaining for NOS (magenta), co-stained for acetylated α-tubulin (acTub; green). (\textbf  {H}) Synaptic wiring diagram of the cPRC circuit. Hexagons represent cell groups, with the number of cells per group shown in square brackets. Arrows represent the summed number of synaptic contacts between cell groups. Arrow thickness is proportional to the number of synapses.}}{5}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Nitric oxide is produced during UV/violet stimulation of the cPRCs}{5}{subsubsection*.7}\protected@file@percent }
\newlabel{nitric-oxide-is-produced-during-uvviolet-stimulation-of-the-cprcs}{{}{5}{Nitric oxide is produced during UV/violet stimulation of the cPRCs}{subsubsection*.7}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Figure 2. NO produced by UV/violet stimulation to cPRCs.} (\textbf  {A}) Left: The larvae were embedded in 2\% agarose seawater with the anterior side down. Right: Changes in DAF-FM fluorescence intensities were examined when the ciliary region of the cPRC was stimulated with a 405 nm laser.(\textbf  {B}) DAF-FM fluorescence in the region of the neurosecretory neuropil. The white line indicates the outline of the larva. The dashed line corresponds to the area where fluorescence was quantified. The circles indicate the location of cPRC and control stimulation. The cPRCs are marked by thin lines. (\textbf  {C}) DAF-FM fluorescence before and during 405 nm light stimulation. (\textbf  {D}) Changes in DAF-FM fluorescence over time during 405 nm stimulation of the cPRCs or a control area (ctr stim.). The purple box indicates the duration of 405 nm stimulation. Individual normalized traces (ΔF/F0) are shown as thin lines. Thick lines show the mean value with 0.95 confidence intervals. N = 9 larvae for control and 11 for cPRC stimulation. Figure 2 -- source data 1. DAF-FM fluorescence reads.}}{6}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Nitric oxide signalling mediates UV-avoidance behaviour}{6}{subsubsection*.9}\protected@file@percent }
\newlabel{nitric-oxide-signalling-mediates-uv-avoidance-behaviour}{{}{6}{Nitric oxide signalling mediates UV-avoidance behaviour}{subsubsection*.9}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Figure 3. NOS is required for UV avoidance in \emph  {Platynereis} larvae.} (\textbf  {A}) Schematic diagram of the set-up of the behavioural experiment. (\textbf  {B}) Vertical displacement in 30 sec bins of wild type (10 batches) and mutant (\emph  {NOSΔ11/Δ11}, 5 batches and \emph  {NOSΔ23/Δ23}, 7 batches) 3-day-old larvae stimulated with 395 nm light from the side, 488 nm light from the top and 395 nm light from the top. One-way ANOVA with Dunnett's multiple-comparison test are shown. \textsuperscript  {*}P \textless {} 0.05, \textsuperscript  {**}P \textless {} 0.01. (\textbf  {C}) Swimming trajectories of wild type (WT, n=32) and \emph  {NOS} mutant (\emph  {NOSΔ11/Δ11}, n=26 and \emph  {NOSΔ23/Δ23}, n=47) 3-day-old larvae. All trajectories start at 0 x and y position and time 0 corresponding to 10 sec before the onset of 395 nm stimulation from the side. (\textbf  {D}) Vertical position of batches of wild type and mutant 3-day-old larvae over time under 395 nm UV stimulation. The starting position of each larval trajectory was set to 0. (\textbf  {E}) Comparison of vertical position of wild type and mutant 3-day-old larvae after 30 seconds of UV stimulation. One-way ANOVA with Dunnett's multiple-comparison test are shown. The wild type (WT, n=32) and \emph  {NOS} mutant (\emph  {NOSΔ11/Δ11}, n=26 and \emph  {NOSΔ23/Δ23}, n=47) larvae. (\textbf  {F}) Vertical displacement in 30 sec bins of control (15 batches) and L-NAME-treated (0.1 and 1 mM, 15 batches each) 3-day-old larvae stimulated with 395 nm light from the side, 488 nm light from the top and 395 nm light from the top. One-way ANOVA with Dunnett's multiple-comparison test are shown. \textsuperscript  {*}P \textless {} 0.05. (\textbf  {G}) Vertical position of batches of control and L-NAME-treated (0.1 and 1 mM) 3-day-old larvae over time under 395 nm UV stimulation. The starting position of each larval trajectory was set to 0. (\textbf  {H}) Comparison of vertical position of control (n=6) and L-NAME-treated (0.1 and 1 mM, n=6 each) 3-day-old larvae after 30 seconds of UV stimulation. One-way ANOVA with Dunnett's multiple-comparison test are shown. Figure 3 -- source data 1-7. Source data for panels A-G.}}{8}{figure.caption.10}\protected@file@percent }
